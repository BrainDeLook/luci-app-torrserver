#!/bin/sh

. /usr/share/libubox/jshn.sh

status() {
	local pid port enabled rss available version cpu_total proc_ticks prev_pid prev_total prev_ticks cpu_pct
	pid="$(ubus call service list '{"name":"torrserver"}' 2>/dev/null | jsonfilter -e '@.torrserver.instances.*.pid' | head -n 1)"
	port="$(uci -q get torrserver.main.port)"
	case "$port" in ''|*[!0-9]*) port=8090 ;; esac
	enabled="$(uci -q get torrserver.main.enabled)"
	rss=0
	cpu_pct=0
	cpu_total="$(awk '/^cpu / {for (field=2; field<=9; field++) total += $field; print total; exit}' /proc/stat)"
	if [ -n "$pid" ] && [ -r "/proc/$pid/status" ]; then
		rss="$(awk '/^VmRSS:/ {print $2}' "/proc/$pid/status")"
		proc_ticks="$(awk '{print $14+$15}' "/proc/$pid/stat")"
		if [ -r /tmp/torrserver-luci-cpu ]; then
			read -r prev_pid prev_total prev_ticks < /tmp/torrserver-luci-cpu
			if [ "$pid" = "$prev_pid" ] && [ "$cpu_total" -gt "$prev_total" ]; then
				cpu_pct="$(awk -v current="$proc_ticks" -v previous="$prev_ticks" -v total="$cpu_total" -v before="$prev_total" 'BEGIN {printf "%.1f", 100*(current-previous)/(total-before)}')"
			fi
		fi
		(umask 077; printf '%s %s %s\n' "$pid" "$cpu_total" "$proc_ticks" > "/tmp/torrserver-luci-cpu.$$") && mv -f "/tmp/torrserver-luci-cpu.$$" /tmp/torrserver-luci-cpu
	fi
	available="$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)"
	version="$(cat /usr/share/torrserver/version 2>/dev/null)"
	json_init
	json_add_string version "$version"
	json_add_object service
	json_add_boolean running "${pid:+1}"
	json_add_int pid "${pid:-0}"
	json_add_boolean enabled "$enabled"
	json_close_object
	json_add_object proc
	json_add_int rss_kb "${rss:-0}"
	json_add_string cpu_pct "$cpu_pct"
	json_close_object
	json_add_object ram
	json_add_int avail_kb "${available:-0}"
	json_close_object
	json_add_object web
	json_add_int port "$port"
	json_close_object
	json_dump
}

logs() {
	local lines
	lines="$(logread -e torrserver 2>/dev/null | tail -n 100)"
	[ -n "$lines" ] || lines="$(logread -e TorrServer 2>/dev/null | tail -n 100)"
	json_init
	json_add_array lines
	if [ -n "$lines" ]; then
		while IFS= read -r line; do
			json_add_string '' "$line"
		done <<EOF
$lines
EOF
	fi
	json_close_array
	json_dump
}

case "$1:$2" in
	list:*) printf '%s\n' '{"status":{},"log":{}}' ;;
	call:status) status ;;
	call:log) logs ;;
	*) printf '%s\n' '{"error":"Unknown method"}'; exit 1 ;;
esac
