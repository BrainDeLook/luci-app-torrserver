#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/torrserver

fail() {
	logger -t torrserver "$1"
	return 1
}

add_option() {
	local value
	config_get value main "$1" ''
	[ -z "$value" ] || procd_append_param command "$2" "$value"
}

add_flag() {
	local enabled
	config_get_bool enabled main "$1" 0
	[ "$enabled" -ne 1 ] || procd_append_param command "$2"
}

start_service() {
	local enabled port path httpauth username password proxyurl proxymode maxsize ip auth_tmp
	config_load torrserver
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0
	[ -x "$PROG" ] || return 1
	config_get port main port 8090
	config_get path main path /opt/torrserver
	config_get ip main ip ''
	config_get maxsize main maxsize ''
	config_get proxyurl main proxyurl ''
	config_get proxymode main proxymode tracker
	config_get_bool httpauth main httpauth 0
	case "$port" in ''|*[!0-9]*) fail 'Invalid HTTP port'; return 1 ;; esac
	[ "$port" -ge 1 ] && [ "$port" -le 65535 ] || { fail 'HTTP port must be 1-65535'; return 1; }
	case "$path" in /*) ;; *) fail 'Data directory must be an absolute path'; return 1 ;; esac
	case "$maxsize" in *[!0-9]*) fail 'Stream size limit must be an integer in bytes'; return 1 ;; esac
	case "$proxymode" in tracker|peers|full) ;; all) proxymode=full ;; *) fail 'Invalid proxy mode'; return 1 ;; esac
	mkdir -p "$path" || return 1
	chmod 600 /etc/config/torrserver
	if [ "$httpauth" -eq 1 ]; then
		config_get username main auth_user ''
		config_get password main auth_password ''
		if [ -n "$username" ] && [ -n "$password" ]; then
			. /usr/share/libubox/jshn.sh
			json_init
			json_add_string "$username" "$password"
			auth_tmp="$(umask 077; mktemp "$path/.accs.XXXXXX")" || return 1
			if ! json_dump > "$auth_tmp"; then
				rm -f "$auth_tmp"
				return 1
			fi
			mv -f "$auth_tmp" "$path/accs.db" || return 1
		elif [ ! -s "$path/accs.db" ]; then
			fail 'HTTP authentication requires credentials or an existing accs.db'
			return 1
		fi
		chmod 600 "$path/accs.db"
	fi
	procd_open_instance
	procd_set_param command "$PROG" --port "$port" --path "$path"
	[ -z "$ip" ] || procd_append_param command --ip "$ip"
	if [ -n "$proxyurl" ]; then
		procd_append_param command --proxyurl "$proxyurl" --proxymode "$proxymode"
	fi
	add_option logpath --logpath
	add_option weblogpath --weblogpath
	add_option torrentsdir --torrentsdir
	add_option torrentaddr --torrentaddr
	add_option pubipv4 --pubipv4
	add_option pubipv6 --pubipv6
	add_option maxsize --maxsize
	add_option tg -T
	add_option fuse -f
	add_flag httpauth --httpauth
	add_flag rdb --rdb
	add_flag webdav --webdav
	add_flag searchwa --searchwa
	procd_set_param file /etc/config/torrserver
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 15
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger torrserver
}
