config torrserver 'main'
	option enabled '1'
	option port '8090'
	option path '/opt/torrserver'
	option ip ''
	option httpauth '0'
	option auth_user 'torrserver'
	option auth_password ''
	option proxymode 'tracker'
	option proxyurl ''
	option rdb '0'
	option webdav '0'
	option logpath ''
	option weblogpath ''
	option torrentsdir ''
	option torrentaddr ''
	option pubipv4 ''
	option pubipv6 ''
	option maxsize ''
	option tg ''
	option fuse ''
